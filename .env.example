# ============================================================================
# CityPulse — Public Environment Configuration Template (.env.example)
# Copy this file to `.env.local` (for local development) or configure these
# variables in Vercel / Netlify project settings.
#
# SECURITY WARNING:
# NEVER place a SUPABASE_SERVICE_ROLE_KEY or database password in any
# VITE_* variable or frontend file. Only the public URL and public anon key
# belong in browser-exposed variables; PostgreSQL Row-Level Security (RLS)
# enforces all data access rules on the server.
# ============================================================================

# 1. Required: Supabase Project URL & Public Anonymous Key
# Obtain from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-here"

# 2. Optional: MapLibre GL JS Style URL (Defaults to OpenFreeMap Liberty style)
VITE_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# 3. Optional: Configurable Geocoding Endpoint (Defaults to Nominatim OSM with explicit user-triggered search)
VITE_GEOCODER_URL="https://nominatim.openstreetmap.org/search"

# 4. Optional: Enable Google OAuth Sign-In button ONLY when Google Provider is configured in Supabase Auth
VITE_ENABLE_GOOGLE_OAUTH="false"

# 5. Production site base URL used in signup-confirmation and password-reset emails.
# In Vercel/Netlify, set this to your deployed HTTPS URL (no trailing slash).
# For local-only testing, leave empty; email links will use the local browser origin.
VITE_SITE_URL=""
